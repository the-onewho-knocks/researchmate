# --- Gemini (quota-limited) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
THINKING_BUDGET=0

# --- Local LLM: LM Studio / Ollama / vLLM (OpenAI-compatible) ---
# LM Studio default: http://localhost:1234/v1
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=qwen/qwen3-4b-2507
LOCAL_LLM_API_KEY=
LOCAL_LLM_TIMEOUT_S=120
LOCAL_LLM_CONTEXT_MAX_CHARS=3500

# --- Routing: Gemini does the high-impact work, the local model does the bulk ---
GEMINI_MAX_CALLS_PER_EVAL=3
GEMINI_MAX_INPUT_TOKENS=5000
GEMINI_TOKEN_SHARE=0.30
GEMINI_RPM=10
GEMINI_TPM=250000
GEMINI_RPD=250
GEMINI_CIRCUIT_BREAKER_S=60
GEMINI_ESCALATION_MAX=3
ROUTING_VERSION=1

# upload limits
MAX_UPLOAD_MB=20
MAX_PAGES=60

# ML layer (embedder). Set false when a local LLM already owns the GPU.
ML_ENABLED=false
ML_ACCEPT_T=0.75
ML_REJECT_T=0.25
PROMPT_VERSION=1

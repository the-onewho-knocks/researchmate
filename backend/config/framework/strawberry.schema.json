                "tier": {"enum": ["A", "B", "C"]},
                "params": {"type": "object"},
                "rule": {"type": "string"},
                "ml_label": {"type": "string"},
                "hint": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}